{
  "name": "dsh-merge-preset",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "dsh-llm-direct": "*"
  },
  "peerDependenciesMeta": {
    "dsh-llm-direct": {
      "optional": false,
      "description": "Adapter code. Install as a bundle first; see README."
    }
  },
  "description": "Merge Gateway models for DeepSeek Harness, configured from a Settings page instead of a YAML file.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "merge",
    "settings",
    "llm",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unnidentified/dsh-merge-preset.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
